{
  "name": "release-signal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "pages:build": "vinext build && node scripts/prepare-cloudflare-pages.mjs",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs && node --experimental-strip-types --test tests/catalog-integrity.test.ts tests/application.test.ts tests/cloud-news.test.ts tests/multilingual.test.ts tests/ip-features.test.ts tests/http-cache.test.ts tests/ip-engine.test.ts tests/ip-clock.test.ts",
    "engine:deploy": "wrangler deploy --config wrangler.engine.jsonc",
    "engine:dev": "wrangler dev --config wrangler.engine.jsonc --test-scheduled",
    "engine:admin": "wrangler dev --config wrangler.engine-admin.jsonc --remote --test-scheduled --port 8788",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply release-signal-accounts --remote",
    "typecheck": "tsc --noEmit",
    "catalog:refresh": "node --experimental-strip-types scripts/refresh-catalog.mjs",
    "catalog:validate": "node --experimental-strip-types --test tests/catalog-integrity.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vinext --ignore-pattern work --ignore-pattern outputs --ignore-pattern .wrangler"
  },
  "dependencies": {
    "linkedom": "^0.18.12",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
